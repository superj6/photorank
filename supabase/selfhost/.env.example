# Copy to .env next to docker-compose.yml. Never commit .env.
POSTGRES_PASSWORD=change-me-openssl-rand-hex-32
JWT_SECRET=change-me-at-least-32-characters-long
# From: python3 tool/selfhost_keys.py "$JWT_SECRET"
ANON_KEY=
SERVICE_ROLE_KEY=
# Public HTTPS origin nginx serves (no trailing slash).
API_EXTERNAL_URL=https://api.example.com
